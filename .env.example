POSTGRES_PORT=5433
API_PORT=8002
FRONTEND_PORT=5174

POSTGRES_DB=aapdasetu
POSTGRES_USER=aapdasetu
POSTGRES_PASSWORD=change-me-for-local-development

BASIN_NAME=Lower Kosi Sub-Basin
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
# JSON object keyed by configured pipeline name; leave empty until configured.
BHASHINI_PIPELINE_ENDPOINTS={}
TELEMETRY_SENTINELS_PATH=
GOOGLE_MAPS_API_KEY=

# Local email verification uses Mailpit (SMTP :1025, Web UI :8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@aapdasetu.local
MAILPIT_UI_URL=http://localhost:8025
FRONTEND_BASE_URL=http://localhost:5174
# Generate a random secret of at least 32 characters for local/dev environments.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=60
EMAIL_VERIFICATION_TOKEN_MINUTES=1440

# Optional one-time bootstrap values. Admin sign-in uses the username; the
# email remains the account contact address. Remove these after bootstrapping.
BOOTSTRAP_ADMIN_FULL_NAME=AapdaSetu Admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@aapdasetu.local
BOOTSTRAP_ADMIN_PASSWORD=1
AUTH_JWT_SECRET=aapdasetu-local-dev-secret-key-2026-change-me-in-prod-98765
